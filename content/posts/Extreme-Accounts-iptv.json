2027-01-17T00:00:00'\n        },\n        {\n            mac: '00:1A:79:00:14:2E',\n            expiration: '2026-09-07T00:00:00'\n        },\n        {\n            mac: '00:1A:79:00:17:1F',\n            expiration: '2027-02-09T00:00:00'\n        },\n        {\n            mac: '00:1A:79:00:1B:64',\n            expiration: '2027-02-06T00:00:00'\n        }\n    ];\n\n    const portalUrl = 'http://mag.jee-ott.xyz:80/c/';\n\n    /*\n     * ============================================================\n     * أدوات مساعدة\n     * ============================================================\n     */\n\n    function escapeHtml(value) {\n        const div = document.createElement('div');\n        div.textContent = String(value ?? '');\n        return div.innerHTML;\n    }\n\n    function normalizeExpiration(value) {\n        if (!value) {\n            return null;\n        }\n\n        const date = new Date(value);\n\n        if (Number.isNaN(date.getTime())) {\n            return null;\n        }\n\n        return date;\n    }\n\n    function getAccountState(expiration) {\n        if (!expiration) {\n            return {\n                label: 'غير محدد',\n                classes: 'bg-blue-900/50 text-blue-400 border-blue-700',\n                border: 'border-l-blue-500'\n            };\n        }\n\n        const date = normalizeExpiration(expiration);\n\n        if (!date) {\n            return {\n                label: 'غير محدد',\n                classes: 'bg-gray-800 text-gray-400 border-gray-700',\n                border: 'border-l-gray-500'\n            };\n        }\n\n        const now = new Date();\n\n        if (date.getTime() < now.getTime()) {\n            return {\n                label: 'منتهي',\n                classes: 'bg-red-900/50 text-red-400 border-red-700',\n                border: 'border-l-red-500'\n            };\n        }\n\n        return {\n            label: 'Active',\n            classes: 'bg-green-900/50 text-green-400 border-green-700',\n            border: 'border-l-green-500'\n        };\n    }\n\n    function formatDate(dateValue) {\n        if (!dateValue) {\n            return 'غير محدد';\n        }\n\n        const date = normalizeExpiration(dateValue);\n\n        if (!date) {\n            return 'غير محدد';\n        }\n\n        const day = String(date.getDate()).padStart(2, '0');\n        const month = String(date.getMonth() + 1).padStart(2, '0');\n        const year = date.getFullYear();\n\n        return `${day}/${month}/${year}`;\n    }\n\n    function formatDateTime(dateValue) {\n        if (!dateValue) {\n            return 'غير محدد';\n        }\n\n        const date = normalizeExpiration(dateValue);\n\n        if (!date) {\n            return 'غير محدد';\n        }\n\n        const day = String(date.getDate()).padStart(2, '0');\n        const month = String(date.getMonth() + 1).padStart(2, '0');\n        const year = date.getFullYear();\n\n        const hours = date.getHours();\n        const minutes = String(date.getMinutes()).padStart(2, '0');\n\n        const hour12 = hours % 12 || 12;\n        const period = hours >= 12 ? 'PM' : 'AM';\n\n        return `${day}/${month}/${year} ${hour12}:${minutes} ${period}`;\n    }\n\n    function buildM3uUrl(account) {\n        const baseUrl = account.domain.replace(/\\/+$/, '');\n\n        const params = new URLSearchParams({\n            username: account.username,\n            password: account.password,\n            type: 'm3u_plus'\n        });\n\n        return `${baseUrl}/get.php?${params.toString()}`;\n    }\n\n    /*\n     * ============================================================\n     * إنشاء بطاقة Xtream\n     * ============================================================\n     */\n\n    function createXtreamCard(account) {\n        const state = getAccountState(account.expiration);\n        const m3uUrl = buildM3uUrl(account);\n\n        const card = document.createElement('div');\n\n        card.className = [\n            'my-6',\n            'dir-ltr'\n        ].join(' ');\n\n        card.setAttribute('dir', 'ltr');\n\n        card.innerHTML = `\n            <div class=\"bg-[#1e1e1e] rounded-2xl overflow-hidden border border-gray-700 shadow-lg hover:border-blue-500 transition-colors ${state.border} border-l-4\">\n\n                <div class=\"bg-[#2d2d2d] px-4 py-3 flex flex-col sm:flex-row gap-3 justify-between items-start sm:items-center border-b border-gray-700\">\n\n                    <div class=\"flex flex-col gap-1\">\n                        <span class=\"text-sm text-gray-300 font-bold\">\n                            ${escapeHtml(account.name)}\n                        </span>\n\n                        <span class=\"text-xs text-gray-500 font-mono\">\n                            Expires:\n                            ${escapeHtml(formatDate(account.expiration))}\n                        </span>\n                    </div>\n\n                    <div class=\"flex items-center gap-2\">\n\n                        <span class=\"text-xs text-gray-400 border border-gray-700 px-2.5 py-1 rounded-full\">\n                            Connections: ${escapeHtml(account.connections)}\n                        </span>\n\n                        <span class=\"text-xs font-bold ${state.classes} border px-2.5 py-1 rounded-full\">\n                            ${escapeHtml(state.label)}\n                        </span>\n\n                    </div>\n                </div>\n\n                <div class=\"p-5 overflow-x-auto text-left\">\n\n                    <div class=\"space-y-4 font-mono text-sm\">\n\n                        <div class=\"flex flex-col gap-1\">\n                            <span class=\"text-gray-500 text-xs\">URL / Server</span>\n\n                            <button\n                                type=\"button\"\n                                class=\"text-left break-all text-blue-400 hover:text-blue-300 transition-colors cursor-pointer\"\n                                onclick=\"copyToClipboard(${JSON.stringify(account.domain)}, 'تم نسخ الدومين')\">\n                                ${escapeHtml(account.domain)}\n                            </button>\n                        </div>\n\n                        <div class=\"flex flex-col gap-1\">\n                            <span class=\"text-gray-500 text-xs\">Username</span>\n\n                            <button\n                                type=\"button\"\n                                class=\"text-left break-all text-green-400 hover:text-green-300 transition-colors cursor-pointer\"\n                                onclick=\"copyToClipboard(${JSON.stringify(account.username)}, 'تم نسخ اليوزر')\">\n                                ${escapeHtml(account.username)}\n                            </button>\n                        </div>\n\n                        <div class=\"flex flex-col gap-1\">\n                            <span class=\"text-gray-500 text-xs\">Password</span>\n\n                            <button\n                                type=\"button\"\n                                class=\"text-left break-all text-yellow-400 hover:text-yellow-300 transition-colors cursor-pointer\"\n                                onclick=\"copyToClipboard(${JSON.stringify(account.password)}, 'تم نسخ الباسورد')\">\n                                ${escapeHtml(account.password)}\n                            </button>\n                        </div>\n\n                        <div class=\"flex flex-col gap-1 pt-3 border-t border-gray-700\">\n                            <span class=\"text-gray-500 text-xs\">M3U Plus</span>\n\n                            <button\n                                type=\"button\"\n                                class=\"text-left break-all text-purple-400 hover:text-purple-300 transition-colors cursor-pointer\"\n                                onclick=\"copyToClipboard(${JSON.stringify(m3uUrl)}, 'تم نسخ رابط M3U')\">\n                                ${escapeHtml(m3uUrl)}\n                            </button>\n                        </div>\n\n                    </div>\n\n                </div>\n            </div>\n        `;\n\n        return card;\n    }\n\n    /*\n     * ============================================================\n     * إنشاء بطاقة MAG\n     * ============================================================\n     */\n\n    function createMagCard(account) {\n        const state = getAccountState(account.expiration);\n\n        const card = document.createElement('div');\n\n        card.className = 'my-6 dir-ltr';\n        card.setAttribute('dir', 'ltr');\n\n        card.innerHTML = `\n            <div class=\"bg-[#1e1e1e] rounded-2xl overflow-hidden border border-gray-700 shadow-lg hover:border-purple-500 transition-colors ${state.border} border-l-4\">\n\n                <div class=\"bg-[#2d2d2d] px-4 py-3 flex flex-col sm:flex-row gap-3 justify-between items-start sm:items-center border-b border-gray-700\">\n\n                    <div class=\"flex flex-col gap-1\">\n                        <span class=\"text-sm text-gray-300 font-bold\">\n                            MAG / MAC\n                        </span>\n\n                        <span class=\"text-xs text-gray-500 font-mono\">\n                            Expiration:\n                            ${escapeHtml(\n                                account.expiration\n                                    ? formatDateTime(account.expiration)\n                                    : 'غير محدد'\n                            )}\n                        </span>\n                    </div>\n\n                    <span class=\"text-xs font-bold ${state.classes} border px-2.5 py-1 rounded-full\">\n                        ${escapeHtml(state.label)}\n                    </span>\n\n                </div>\n\n                <div class=\"p-5 overflow-x-auto text-left\">\n\n                    <div class=\"space-y-4 font-mono text-sm\">\n\n                        <div class=\"flex flex-col gap-1\">\n\n                            <span class=\"text-gray-500 text-xs\">\n                                MAC Address\n                            </span>\n\n                            <button\n                                type=\"button\"\n                                class=\"text-left text-blue-400 hover:text-blue-300 transition-colors cursor-pointer tracking-wider\"\n                                onclick=\"copyToClipboard(${JSON.stringify(account.mac)}, 'تم نسخ MAC')\">\n                                ${escapeHtml(account.mac)}\n                            </button>\n\n                        </div>\n\n                        <div class=\"flex flex-col gap-1 pt-3 border-t border-gray-700\">\n\n                            <span class=\"text-gray-500 text-xs\">\n                                Portal\n                            </span>\n\n                            <button\n                                type=\"button\"\n                                class=\"text-left break-all text-purple-400 hover:text-purple-300 transition-colors cursor-pointer\"\n                                onclick=\"copyToClipboard(${JSON.stringify(portalUrl)}, 'تم نسخ رابط Portal')\">\n                                ${escapeHtml(portalUrl)}\n                            </button>\n\n                        </div>\n\n                    </div>\n\n                </div>\n            </div>\n        `;\n\n        return card;\n    }\n\n    /*\n     * ============================================================\n     * عرض البيانات\n     * ============================================================\n     */\n\n    function renderAccounts() {\n        const xtreamContainer = document.getElementById('xtream-accounts-container');\n        const magContainer = document.getElementById('mag-accounts-container');\n\n        if (!xtreamContainer || !magContainer) {\n            console.error('IPTV containers were not found.');\n            return;\n        }\n\n        const xtreamFragment = document.createDocumentFragment();\n\n        xtreamAccounts.forEach(function (account) {\n            xtreamFragment.appendChild(createXtreamCard(account));\n        });\n\n        xtreamContainer.replaceChildren(xtreamFragment);\n\n        const magFragment = document.createDocumentFragment();\n\n        magAccounts.forEach(function (account) {\n            magFragment.appendChild(createMagCard(account));\n        });\n\n        magContainer.replaceChildren(magFragment);\n    }\n\n    /*\n     * ============================================================\n     * النسخ إلى الحافظة\n     * ============================================================\n     */\n\n    async function copyToClipboard(text, message) {\n        const value = String(text ?? '');\n\n        if (!value) {\n            showToast('لا توجد بيانات لنسخها', 'error');\n            return;\n        }\n\n        try {\n            if (\n                navigator.clipboard &&\n                typeof navigator.clipboard.writeText === 'function'\n            ) {\n                await navigator.clipboard.writeText(value);\n            } else {\n                fallbackCopy(value);\n            }\n\n            showToast(message || 'تم النسخ بنجاح', 'success');\n\n        } catch (error) {\n            console.error('Clipboard error:', error);\n\n            try {\n                fallbackCopy(value);\n                showToast(message || 'تم النسخ بنجاح', 'success');\n            } catch (fallbackError) {\n                console.error('Fallback clipboard error:', fallbackError);\n                showToast('تعذر نسخ البيانات، حاول مرة أخرى', 'error');\n            }\n        }\n    }\n\n    function fallbackCopy(text) {\n        const textarea = document.createElement('textarea');\n\n        textarea.value = text;\n        textarea.setAttribute('readonly', '');\n        textarea.style.position = 'fixed';\n        textarea.style.top = '-9999px';\n        textarea.style.left = '-9999px';\n        textarea.style.opacity = '0';\n\n        document.body.appendChild(textarea);\n\n        textarea.focus();\n        textarea.select();\n\n        const successful = document.execCommand('copy');\n\n        textarea.remove();\n\n        if (!successful) {\n            throw new Error('Fallback copy operation failed.');\n        }\n    }\n\n    /*\n     * ============================================================\n     * Toast\n     * ============================================================\n     */\n\n    function showToast(message, type) {\n        const existingToast = document.getElementById('iptv-copy-toast');\n\n        if (existingToast) {\n            existingToast.remove();\n        }\n\n        const toast = document.createElement('div');\n\n        toast.id = 'iptv-copy-toast';\n        toast.textContent = message;\n\n        const isError = type === 'error';\n\n        toast.style.cssText = `\n            position: fixed;\n            bottom: 20px;\n            left: 50%;\n            transform: translateX(-50%) translateY(10px);\n            background-color: ${isError ? '#450a0a' : '#2d2d2d'};\n            color: ${isError ? '#fca5a5' : '#4ade80'};\n            padding: 10px 20px;\n            border-radius: 10px;\n            border: 1px solid ${isError ? '#991b1b' : '#166534'};\n            box-shadow: 0 4px 6px rgba(0,0,0,0.3);\n            z-index: 10000;\n            font-family: Tajawal, sans-serif;\n            font-size: 14px;\n            opacity: 0;\n            transition:\n                opacity 0.25s ease,\n                transform 0.25s ease;\n            pointer-events: none;\n            max-width: calc(100vw - 32px);\n            text-align: center;\n        `;\n\n        document.body.appendChild(toast);\n\n        requestAnimationFrame(function () {\n            toast.style.opacity = '1';\n            toast.style.transform = 'translateX(-50%) translateY(0)';\n        });\n\n        window.setTimeout(function () {\n            toast.style.opacity = '0';\n            toast.style.transform = 'translateX(-50%) translateY(10px)';\n\n            window.setTimeout(function () {\n                if (toast.parentNode) {\n                    toast.remove();\n                }\n            }, 300);\n\n        }, 2000);\n    }\n\n    /*\n     * ============================================================\n     * تهيئة المنشور\n     * ============================================================\n     */\n\n    function initialize() {\n        renderAccounts();\n    }\n\n    if (document.readyState === 'loading') {\n        document.addEventListener('DOMContentLoaded', initialize, {\n            once: true\n        });\n    } else {\n        initialize();\n    }\n\n    /*\n     * إبقاء الدالة متاحة للأزرار الموجودة في HTML.\n     */\n    window.copyToClipboard = copyToClipboard;\n\n})();\n</script>",
