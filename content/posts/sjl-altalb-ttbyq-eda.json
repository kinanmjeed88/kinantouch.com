  "content": "<article \n    class=\"font-[Tajawal] max-w-5xl mx-auto bg-slate-50 dark:bg-slate-900 rounded-[2rem] shadow-2xl overflow-hidden border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200\"\n    dir=\"rtl\"\n>\n    <!-- =====================================\n         1. HEADER (Hero Section)\n    ====================================== -->\n    <header class=\"relative bg-gradient-to-bl from-teal-900 via-cyan-800 to-blue-900 text-white px-6 py-12 md:px-12 md:py-16 overflow-hidden\">\n        <!-- Decorative Background Elements -->\n        <div class=\"absolute -top-12 -left-12 w-48 h-48 bg-white/5 rounded-full blur-2xl\" aria-hidden=\"true\"></div>\n        <div class=\"absolute -bottom-12 -right-12 w-64 h-64 bg-teal-400/10 rounded-full blur-3xl\" aria-hidden=\"true\"></div>\n\n        <div class=\"relative z-10 max-w-3xl\">\n            <span class=\"inline-flex items-center gap-2 px-4 py-1.5 mb-6 bg-white/10 border border-white/20 rounded-full text-sm font-medium backdrop-blur-sm\">\n                <span aria-hidden=\"true\">📚</span> تطبيق عربي لإدارة الطلاب\n            </span>\n\n            <h1 class=\"text-3xl md:text-5xl font-black leading-tight mb-4 text-transparent bg-clip-text bg-gradient-to-l from-white to-teal-100\">\n                سجل الطالب | إدارة أسهل ومتابعة أفضل\n            </h1>\n\n            <p class=\"text-lg md:text-xl text-teal-50/90 leading-relaxed font-light\">\n                تطبيق من برمجتي يساعد المعلم والإدارة على تحويل متابعة الطلاب من دفاتر وسجلات متفرقة إلى \n                <strong class=\"text-amber-300 font-bold\">سجل رقمي منظم وسريع الاستخدام</strong>.\n            </p>\n        </div>\n    </header>\n\n    <main class=\"p-6 md:p-12 space-y-16\">\n        \n        <!-- =====================================\n             2. ABOUT SECTION\n        ====================================== -->\n        <section aria-labelledby=\"about-title\" class=\"max-w-3xl\">\n            <h2 id=\"about-title\" class=\"flex items-center gap-3 text-2xl md:text-3xl font-black text-slate-900 dark:text-white mb-6\">\n                <span class=\"flex items-center justify-center w-12 h-12 rounded-2xl bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 shadow-inner\" aria-hidden=\"true\">🏫</span>\n                لماذا أنشأت التطبيق؟\n            </h2>\n            <div class=\"space-y-4 text-slate-600 dark:text-slate-300 text-lg leading-relaxed\">\n                <p>\n                    متابعة الطالب بالمدرسة تحتاج إلى أكثر من مجرد حفظ الاسم والصف. هناك حضور وغياب، درجات، ملاحظات، سلوك، إجراءات، أعذار، وتقارير، ومع كثرة الطلاب تصبح متابعة كل هذه التفاصيل بشكل يدوي متعبة جدًا.\n                </p>\n                <p>\n                    لذلك صممت <strong class=\"text-teal-700 dark:text-teal-400\">سجل الطالب</strong> ليجمع أهم بيانات الطالب في مكان واحد، مع التركيز على <strong class=\"text-amber-700 dark:text-amber-400\">السرعة والتنظيم والخصوصية</strong>.\n                </p>\n            </div>\n        </section>\n\n        <!-- =====================================\n             3. FEATURES SECTION (Semantic List)\n        ====================================== -->\n        <section aria-labelledby=\"features-title\">\n            <h2 id=\"features-title\" class=\"flex items-center gap-3 text-2xl md:text-3xl font-black text-slate-900 dark:text-white mb-8\">\n                <span aria-hidden=\"true\">✨</span> أهم المزايا\n            </h2>\n\n            <ul class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                <!-- Feature Card Template -->\n                <li class=\"bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-shadow\">\n                    <div class=\"flex items-start gap-4\">\n                        <div class=\"flex-shrink-0 w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-900/30 flex items-center justify-center text-xl\" aria-hidden=\"true\">👨‍🎓</div>\n                        <div>\n                            <h3 class=\"font-bold text-lg text-slate-900 dark:text-white mb-2\">إدارة ملفات الطلاب</h3>\n                            <p class=\"text-slate-600 dark:text-slate-400 text-sm leading-relaxed\">إضافة الطلاب والبحث عنهم وتصفية البيانات بسرعة.</p>\n                        </div>\n                    </div>\n                </li>\n\n                <li class=\"bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-shadow\">\n                    <div class=\"flex items-start gap-4\">\n                        <div class=\"flex-shrink-0 w-12 h-12 rounded-xl bg-teal-50 dark:bg-teal-900/30 flex items-center justify-center text-xl\" aria-hidden=\"true\">🏫</div>\n                        <div>\n                            <h3 class=\"font-bold text-lg text-slate-900 dark:text-white mb-2\">الصفوف والشعب</h3>\n                            <p class=\"text-slate-600 dark:text-slate-400 text-sm leading-relaxed\">تنظيم الصفوف والشعب وربط الطلاب بكل مجموعة.</p>\n                        </div>\n                    </div>\n                </li>\n\n                <li class=\"bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-shadow\">\n                    <div class=\"flex items-start gap-4\">\n                        <div class=\"flex-shrink-0 w-12 h-12 rounded-xl bg-emerald-50 dark:bg-emerald-900/30 flex items-center justify-center text-xl\" aria-hidden=\"true\">📝</div>\n                        <div>\n                            <h3 class=\"font-bold text-lg text-slate-900 dark:text-white mb-2\">الحضور والغياب</h3>\n                            <p class=\"text-slate-600 dark:text-slate-400 text-sm leading-relaxed\">تسجيل الحضور والغياب والتأخير والأعذار بشكل منظم.</p>\n                        </div>\n                    </div>\n                </li>\n\n                <li class=\"bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-shadow\">\n                    <div class=\"flex items-start gap-4\">\n                        <div class=\"flex-shrink-0 w-12 h-12 rounded-xl bg-amber-50 dark:bg-amber-900/30 flex items-center justify-center text-xl\" aria-hidden=\"true\">📊</div>\n                        <div>\n                            <h3 class=\"font-bold text-lg text-slate-900 dark:text-white mb-2\">الدرجات والتقييمات</h3>\n                            <p class=\"text-slate-600 dark:text-slate-400 text-sm leading-relaxed\">إدارة الدرجات والتقييمات ومتابعة مستوى الطالب.</p>\n                        </div>\n                    </div>\n                </li>\n\n                <li class=\"bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-shadow\">\n                    <div class=\"flex items-start gap-4\">\n                        <div class=\"flex-shrink-0 w-12 h-12 rounded-xl bg-rose-50 dark:bg-rose-900/30 flex items-center justify-center text-xl\" aria-hidden=\"true\">⭐</div>\n                        <div>\n                            <h3 class=\"font-bold text-lg text-slate-900 dark:text-white mb-2\">السلوك والنقاط</h3>\n                            <p class=\"text-slate-600 dark:text-slate-400 text-sm leading-relaxed\">متابعة السلوك والنقاط والإجراءات المتعلقة بالطالب.</p>\n                        </div>\n                    </div>\n                </li>\n\n                <li class=\"bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-shadow\">\n                    <div class=\"flex items-start gap-4\">\n                        <div class=\"flex-shrink-0 w-12 h-12 rounded-xl bg-violet-50 dark:bg-violet-900/30 flex items-center justify-center text-xl\" aria-hidden=\"true\">📌</div>\n                        <div>\n                            <h3 class=\"font-bold text-lg text-slate-900 dark:text-white mb-2\">الملاحظات</h3>\n                            <p class=\"text-slate-600 dark:text-slate-400 text-sm leading-relaxed\">إضافة الملاحظات الأكاديمية والتربوية لكل طالب.</p>\n                        </div>\n                    </div>\n                </li>\n\n                <!-- Highlighted Feature spanning full width on Mobile/Tablet, 3 columns on Desktop -->\n                <li class=\"col-span-1 md:col-span-2 lg:col-span-3 bg-gradient-to-r from-teal-800 to-cyan-900 text-white p-6 md:p-8 rounded-2xl shadow-lg border border-teal-700\">\n                    <div class=\"flex items-start gap-5\">\n                        <div class=\"flex-shrink-0 w-14 h-14 rounded-2xl bg-white/10 backdrop-blur-md flex items-center justify-center text-2xl border border-white/20\" aria-hidden=\"true\">📋</div>\n                        <div>\n                            <h3 class=\"font-black text-xl mb-2\">ملف شامل لكل طالب</h3>\n                            <p class=\"text-teal-50 leading-relaxed max-w-4xl\">\n                                يجمع أهم معلومات الطالب في مكان واحد، لتكون الصورة الكاملة أمام المعلم والإدارة بدون التنقل بين سجلات متعددة وتضييع الوقت.\n                            </p>\n                        </div>\n                    </div>\n                </li>\n            </ul>\n        </section>\n\n        <!-- =====================================\n             4. CROSS-PLATFORM SECTION\n        ====================================== -->\n        <section aria-labelledby=\"platform-title\" class=\"bg-blue-50/50 dark:bg-blue-900/10 border border-blue-100 dark:border-blue-900/30 rounded-[2rem] p-6 md:p-10\">\n            <span class=\"inline-flex items-center gap-2 px-4 py-1.5 mb-6 bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 rounded-full text-sm font-bold uppercase tracking-wider\">\n                🔄 Android & Windows\n            </span>\n\n            <h2 id=\"platform-title\" class=\"text-2xl md:text-3xl font-black text-slate-900 dark:text-white mb-6\">\n                نفس التطبيق على الهاتف والحاسوب\n            </h2>\n\n            <p class=\"text-slate-600 dark:text-slate-300 text-lg leading-relaxed mb-8 max-w-3xl\">\n                لا حاجة لتعلم واجهات مختلفة. التطبيق مصمم ليعمل بتناغم بين نظامي Android و Windows.\n                <strong class=\"text-blue-700 dark:text-blue-400\">البيانات قابلة للنقل المتبادل</strong> عبر نظام النسخ الاحتياطي الذكي.\n            </p>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                <article class=\"bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-100 dark:border-slate-700\">\n                    <h3 class=\"flex items-center gap-3 font-bold text-xl text-slate-900 dark:text-white mb-3\">\n                        <span aria-hidden=\"true\">📱</span> نسخة الهاتف\n                    </h3>\n                    <p class=\"text-slate-600 dark:text-slate-400 leading-relaxed\">\n                        مثالية للاستخدام داخل الصف. سجل الحضور، الدرجات، والملاحظات السريعة في أي وقت، وقم بإنشاء نسخة احتياطية بسهولة.\n                    </p>\n                </article>\n\n                <article class=\"bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-100 dark:border-slate-700\">\n                    <h3 class=\"flex items-center gap-3 font-bold text-xl text-slate-900 dark:text-white mb-3\">\n                        <span aria-hidden=\"true\">💻</span> نسخة الحاسوب\n                    </h3>\n                    <p class=\"text-slate-600 dark:text-slate-400 leading-relaxed\">\n                        توفر مساحة عرض أكبر لإدارة البيانات الشاملة، استخراج التقارير، واستيراد القوائم من ملفات Excel براحة تامة.\n                    </p>\n                </article>\n            </div>\n        </section>\n\n        <!-- =====================================\n             5. PRIVACY & TECH SECTION\n        ====================================== -->\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            <section aria-labelledby=\"privacy-title\" class=\"bg-emerald-50 dark:bg-emerald-900/10 border border-emerald-100 dark:border-emerald-900/30 p-8 rounded-3xl\">\n                <h2 id=\"privacy-title\" class=\"flex items-center gap-2 text-xl font-black text-emerald-800 dark:text-emerald-400 mb-4\">\n                    <span aria-hidden=\"true\">🔒</span> الخصوصية أولًا\n                </h2>\n                <p class=\"text-slate-600 dark:text-slate-300 leading-relaxed mb-6\">\n                    بيانات الطلاب يتم حفظها محليًا على الجهاز باستخدام قواعد بيانات Isar فائقة السرعة، دون الحاجة إلى إنترنت أو خوادم خارجية.\n                </p>\n                <div class=\"flex flex-wrap gap-2\">\n                    <span class=\"px-3 py-1 bg-white dark:bg-slate-800 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800 rounded-lg text-sm font-semibold\">تخزين محلي</span>\n                    <span class=\"px-3 py-1 bg-white dark:bg-slate-800 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800 rounded-lg text-sm font-semibold\">أوفلاين بالكامل</span>\n                </div>\n            </section>\n\n            <section aria-labelledby=\"ai-title\" class=\"bg-violet-50 dark:bg-violet-900/10 border border-violet-100 dark:border-violet-900/30 p-8 rounded-3xl\">\n                <h2 id=\"ai-title\" class=\"flex items-center gap-2 text-xl font-black text-violet-800 dark:text-violet-400 mb-4\">\n                    <span aria-hidden=\"true\">🤖</span> مدعوم بالذكاء الاصطناعي\n                </h2>\n                <p class=\"text-slate-600 dark:text-slate-300 leading-relaxed\">\n                    تم تطوير التطبيق بالاستعانة بأدوات الذكاء الاصطناعي الحديثة لضمان كتابة كود نظيف، آمن، وخالٍ من الأخطاء، مع تصميم يركز على تجربة المستخدم (UX).\n                </p>\n            </section>\n        </div>\n\n        <!-- =====================================\n             6. DOWNLOAD SECTION (CTA)\n        ====================================== -->\n        <section aria-labelledby=\"download-title\" class=\"bg-slate-900 dark:bg-black text-white p-8 md:p-12 rounded-[2rem] text-center md:text-right\">\n            <div class=\"flex flex-col md:flex-row items-center justify-between gap-8\">\n                <div class=\"max-w-xl\">\n                    <h2 id=\"download-title\" class=\"text-2xl md:text-4xl font-black mb-4\">ابدأ بتنظيم سجلاتك الآن</h2>\n                    <p class=\"text-slate-300 text-lg leading-relaxed\">\n                        اختر النسخة المناسبة لنظام التشغيل الخاص بك. التطبيق متاح للتحميل المباشر والآمن.\n                    </p>\n                </div>\n\n                <div class=\"flex flex-col sm:flex-row gap-4 w-full md:w-auto shrink-0\">\n                    <a href=\"https://t.me/techtouch7/5759?single\" target=\"_blank\" rel=\"noopener noreferrer\" \n                       class=\"flex items-center justify-center gap-3 bg-emerald-600 hover:bg-emerald-500 text-white px-8 py-4 rounded-xl font-bold transition-colors focus:ring-4 focus:ring-emerald-500/30 focus:outline-none\">\n                        <span aria-hidden=\"true\" class=\"text-xl\">📱</span> للأندرويد\n                    </a>\n                    \n                    <a href=\"https://t.me/techtouch7/5760?single\" target=\"_blank\" rel=\"noopener noreferrer\" \n                       class=\"flex items-center justify-center gap-3 bg-blue-600 hover:bg-blue-500 text-white px-8 py-4 rounded-xl font-bold transition-colors focus:ring-4 focus:ring-blue-500/30 focus:outline-none\">\n                        <span aria-hidden=\"true\" class=\"text-xl\">💻</span> للويندوز\n                    </a>\n                </div>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- =====================================\n         7. FOOTER\n    ====================================== -->\n    <footer class=\"bg-slate-100 dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800 p-8 text-center\">\n        <h3 class=\"text-lg font-bold text-slate-800 dark:text-slate-200 mb-4\">رأيكم يهمنا لتطوير التطبيق 💡</h3>\n        <p class=\"text-slate-500 dark:text-slate-400 mb-8 max-w-2xl mx-auto leading-relaxed\">\n            إذا كانت لديك أي ملاحظات، اقتراحات، أو أفكار لميزات جديدة، لا تتردد في مشاركتها. هذا التطبيق بني ليخدم المعلمين، وملاحظاتكم هي أساس التحديثات القادمة.\n        </p>\n        \n        <div class=\"inline-flex items-center justify-center gap-2 text-sm font-medium text-slate-600 dark:text-slate-400 py-2 px-6 bg-white dark:bg-slate-900 rounded-full border border-slate-200 dark:border-slate-800\">\n            <span>تطوير وبرمجة شخصية</span>\n            <span class=\"w-1.5 h-1.5 rounded-full bg-teal-500\" aria-hidden=\"true\"></span>\n            <span class=\"text-teal-700 dark:text-teal-400 font-bold\">سجل الطالب</span>\n        </div>\n    </footer>\n</article>\n",
