  "content": "<div\n    class=\"font-[Tajawal] text-base leading-relaxed text-slate-800 dark:text-slate-200 tajawal-font bg-gradient-to-br from-slate-50 via-white to-blue-50 dark:from-[#07111f] dark:via-[#0b1628] dark:to-[#0f1d31] p-5 md:p-10 rounded-[2rem] shadow-2xl border border-slate-200 dark:border-slate-800 max-w-4xl mx-auto\"\n    dir=\"rtl\"\n>\n\n    <!-- =========================\n         العنوان الرئيسي\n    ========================== -->\n    <div class=\"relative overflow-hidden rounded-[1.7rem] mb-10 p-7 md:p-9 bg-gradient-to-l from-[#0f3d5e] via-[#145a7a] to-[#178b8c] text-white shadow-xl\">\n\n        <!-- زخرفة -->\n        <div class=\"absolute -top-16 -left-10 w-40 h-40 bg-white/10 rounded-full\"></div>\n        <div class=\"absolute -bottom-20 right-10 w-52 h-52 bg-white/5 rounded-full\"></div>\n\n        <div class=\"relative z-10\">\n\n            <div class=\"inline-flex items-center gap-2 px-4 py-2 mb-5 rounded-full bg-white/10 border border-white/20 text-sm font-bold\">\n                <span>📚</span>\n                <span>تطبيق عربي لإدارة الطلاب</span>\n            </div>\n\n            <h1 class=\"font-black text-3xl md:text-4xl leading-tight mb-4 flex items-start gap-3\">\n                <span>🎓</span>\n                <span>سجل الطالب | إدارة أسهل ومتابعة أفضل</span>\n            </h1>\n\n            <p class=\"text-white/90 text-lg leading-relaxed max-w-3xl\">\n                تطبيق من برمجتي يساعد المعلم والإدارة على تحويل متابعة الطلاب\n                من دفاتر وسجلات متفرقة إلى <strong class=\"text-amber-300\">سجل رقمي منظم وسريع الاستخدام</strong>.\n            </p>\n\n        </div>\n    </div>\n\n\n    <!-- =========================\n         مقدمة\n    ========================== -->\n    <div class=\"mb-10\">\n\n        <h2 class=\"font-black text-2xl mb-5 text-[#0f3d5e] dark:text-blue-300 flex items-center gap-3\">\n            <span class=\"flex items-center justify-center w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-950/50\">\n                🏫\n            </span>\n            لماذا أنشأت التطبيق؟\n        </h2>\n\n        <p class=\"text-gray-700 dark:text-gray-300 leading-8 text-lg\">\n            متابعة الطالب بالمدرسة تحتاج إلى أكثر من مجرد حفظ الاسم والصف.\n            هناك حضور وغياب، درجات، ملاحظات، سلوك، إجراءات، أعذار، وتقارير،\n            ومع كثرة الطلاب تصبح متابعة كل هذه التفاصيل بشكل يدوي متعبة جدًا.\n        </p>\n\n        <p class=\"mt-5 text-gray-700 dark:text-gray-300 leading-8 text-lg\">\n            لذلك صممت <strong class=\"text-[#0f766e] dark:text-teal-400\">سجل الطالب</strong>\n            ليجمع أهم بيانات الطالب في مكان واحد، مع التركيز على\n            <strong class=\"text-[#b45309] dark:text-amber-400\">السرعة والتنظيم والخصوصية</strong>.\n        </p>\n\n    </div>\n\n\n    <!-- =========================\n         بطاقة المزايا\n    ========================== -->\n    <div class=\"mb-10\">\n\n        <h2 class=\"font-black text-2xl mb-6 text-slate-900 dark:text-white flex items-center gap-3\">\n            <span>✨</span>\n            أهم المزايا\n        </h2>\n\n        <div class=\"grid md:grid-cols-2 gap-4\">\n\n            <!-- ميزة -->\n            <div class=\"group p-5 rounded-2xl bg-white dark:bg-[#111c2d] border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1\">\n                <div class=\"flex items-start gap-4\">\n                    <div class=\"flex-shrink-0 w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-950/50 flex items-center justify-center text-xl\">\n                        👨‍🎓\n                    </div>\n                    <div>\n                        <h3 class=\"font-black text-lg text-slate-900 dark:text-white mb-1\">\n                            إدارة ملفات الطلاب\n                        </h3>\n                        <p class=\"text-gray-600 dark:text-gray-400 leading-7\">\n                            إضافة الطلاب والبحث عنهم وتصفية البيانات بسرعة.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- ميزة -->\n            <div class=\"group p-5 rounded-2xl bg-white dark:bg-[#111c2d] border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1\">\n                <div class=\"flex items-start gap-4\">\n                    <div class=\"flex-shrink-0 w-12 h-12 rounded-xl bg-teal-100 dark:bg-teal-950/40 flex items-center justify-center text-xl\">\n                        🏫\n                    </div>\n                    <div>\n                        <h3 class=\"font-black text-lg text-slate-900 dark:text-white mb-1\">\n                            الصفوف والشعب\n                        </h3>\n                        <p class=\"text-gray-600 dark:text-gray-400 leading-7\">\n                            تنظيم الصفوف والشعب وربط الطلاب بكل مجموعة.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- ميزة -->\n            <div class=\"group p-5 rounded-2xl bg-white dark:bg-[#111c2d] border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1\">\n                <div class=\"flex items-start gap-4\">\n                    <div class=\"flex-shrink-0 w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-950/40 flex items-center justify-center text-xl\">\n                        📝\n                    </div>\n                    <div>\n                        <h3 class=\"font-black text-lg text-slate-900 dark:text-white mb-1\">\n                            الحضور والغياب\n                        </h3>\n                        <p class=\"text-gray-600 dark:text-gray-400 leading-7\">\n                            تسجيل الحضور والغياب والتأخير والأعذار بشكل منظم.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- ميزة -->\n            <div class=\"group p-5 rounded-2xl bg-white dark:bg-[#111c2d] border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1\">\n                <div class=\"flex items-start gap-4\">\n                    <div class=\"flex-shrink-0 w-12 h-12 rounded-xl bg-amber-100 dark:bg-amber-950/40 flex items-center justify-center text-xl\">\n                        📊\n                    </div>\n                    <div>\n                        <h3 class=\"font-black text-lg text-slate-900 dark:text-white mb-1\">\n                            الدرجات والتقييمات\n                        </h3>\n                        <p class=\"text-gray-600 dark:text-gray-400 leading-7\">\n                            إدارة الدرجات والتقييمات ومتابعة مستوى الطالب.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- ميزة -->\n            <div class=\"group p-5 rounded-2xl bg-white dark:bg-[#111c2d] border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1\">\n                <div class=\"flex items-start gap-4\">\n                    <div class=\"flex-shrink-0 w-12 h-12 rounded-xl bg-rose-100 dark:bg-rose-950/40 flex items-center justify-center text-xl\">\n                        ⭐\n                    </div>\n                    <div>\n                        <h3 class=\"font-black text-lg text-slate-900 dark:text-white mb-1\">\n                            السلوك والنقاط\n                        </h3>\n                        <p class=\"text-gray-600 dark:text-gray-400 leading-7\">\n                            متابعة السلوك والنقاط والإجراءات المتعلقة بالطالب.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- ميزة -->\n            <div class=\"group p-5 rounded-2xl bg-white dark:bg-[#111c2d] border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1\">\n                <div class=\"flex items-start gap-4\">\n                    <div class=\"flex-shrink-0 w-12 h-12 rounded-xl bg-violet-100 dark:bg-violet-950/40 flex items-center justify-center text-xl\">\n                        📌\n                    </div>\n                    <div>\n                        <h3 class=\"font-black text-lg text-slate-900 dark:text-white mb-1\">\n                            الملاحظات\n                        </h3>\n                        <p class=\"text-gray-600 dark:text-gray-400 leading-7\">\n                            إضافة الملاحظات الأكاديمية والتربوية لكل طالب.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- ميزة -->\n            <div class=\"group p-5 rounded-2xl bg-white dark:bg-[#111c2d] border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1\">\n                <div class=\"flex items-start gap-4\">\n                    <div class=\"flex-shrink-0 w-12 h-12 rounded-xl bg-sky-100 dark:bg-sky-950/40 flex items-center justify-center text-xl\">\n                        📥\n                    </div>\n                    <div>\n                        <h3 class=\"font-black text-lg text-slate-900 dark:text-white mb-1\">\n                            استيراد Excel\n                        </h3>\n                        <p class=\"text-gray-600 dark:text-gray-400 leading-7\">\n                            استيراد قوائم الطلاب من ملفات Excel بسهولة.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- ميزة -->\n            <div class=\"group p-5 rounded-2xl bg-white dark:bg-[#111c2d] border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1\">\n                <div class=\"flex items-start gap-4\">\n                    <div class=\"flex-shrink-0 w-12 h-12 rounded-xl bg-orange-100 dark:bg-orange-950/40 flex items-center justify-center text-xl\">\n                        📤\n                    </div>\n                    <div>\n                        <h3 class=\"font-black text-lg text-slate-900 dark:text-white mb-1\">\n                            تصدير التقارير\n                        </h3>\n                        <p class=\"text-gray-600 dark:text-gray-400 leading-7\">\n                            تصدير البيانات والتقارير بصيغ Excel وPDF وJSON.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- ميزة -->\n            <div class=\"group p-5 rounded-2xl bg-white dark:bg-[#111c2d] border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1\">\n                <div class=\"flex items-start gap-4\">\n                    <div class=\"flex-shrink-0 w-12 h-12 rounded-xl bg-red-100 dark:bg-red-950/40 flex items-center justify-center text-xl\">\n                        🔔\n                    </div>\n                    <div>\n                        <h3 class=\"font-black text-lg text-slate-900 dark:text-white mb-1\">\n                            التنبيهات المحلية\n                        </h3>\n                        <p class=\"text-gray-600 dark:text-gray-400 leading-7\">\n                            تنبيهات محلية للحالات السلوكية المهمة.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- ميزة -->\n            <div class=\"group p-5 rounded-2xl bg-white dark:bg-[#111c2d] border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1\">\n                <div class=\"flex items-start gap-4\">\n                    <div class=\"flex-shrink-0 w-12 h-12 rounded-xl bg-cyan-100 dark:bg-cyan-950/40 flex items-center justify-center text-xl\">\n                        💾\n                    </div>\n                    <div>\n                        <h3 class=\"font-black text-lg text-slate-900 dark:text-white mb-1\">\n                            النسخ الاحتياطي\n                        </h3>\n                        <p class=\"text-gray-600 dark:text-gray-400 leading-7\">\n                            إنشاء نسخ احتياطية واستعادة البيانات عند الحاجة.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- ميزة رئيسية -->\n            <div class=\"group p-5 rounded-2xl bg-gradient-to-l from-[#0f3d5e] to-[#147d83] text-white shadow-lg md:col-span-2\">\n                <div class=\"flex items-start gap-4\">\n                    <div class=\"flex-shrink-0 w-12 h-12 rounded-xl bg-white/15 flex items-center justify-center text-xl\">\n                        📋\n                    </div>\n                    <div>\n                        <h3 class=\"font-black text-lg mb-1\">\n                            ملف شامل لكل طالب\n                        </h3>\n                        <p class=\"text-white/85 leading-7\">\n                            يجمع أهم معلومات الطالب في مكان واحد، لتكون الصورة الكاملة\n                            أمام المعلم والإدارة بدون التنقل بين سجلات متعددة.\n                        </p>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n\n\n    <!-- =========================\n         الخصوصية\n    ========================== -->\n    <div class=\"relative overflow-hidden mb-10 rounded-[1.5rem] border border-emerald-200 dark:border-emerald-900/50 bg-emerald-50 dark:bg-emerald-950/20 p-6 md:p-7\">\n\n        <div class=\"absolute -left-8 -top-8 w-24 h-24 bg-emerald-200/30 dark:bg-emerald-700/10 rounded-full\"></div>\n\n        <div class=\"relative z-10\">\n\n            <h2 class=\"font-black text-xl mb-4 text-emerald-800 dark:text-emerald-400 flex items-center gap-2\">\n                <span>🔒</span>\n                الخصوصية أولًا\n            </h2>\n\n            <p class=\"text-gray-700 dark:text-gray-300 leading-8\">\n                بيانات الطلاب يتم حفظها\n                <strong class=\"text-emerald-700 dark:text-emerald-400\">\n                    محليًا على الجهاز\n                </strong>\n                باستخدام قاعدة بيانات\n                <strong class=\"text-indigo-700 dark:text-indigo-400\">\n                    Isar\n                </strong>\n                دون الحاجة إلى خادم خارجي أو اتصال دائم بالإنترنت.\n            </p>\n\n            <div class=\"mt-5 flex flex-wrap gap-3\">\n\n                <span class=\"px-4 py-2 rounded-full bg-white dark:bg-[#10251d] border border-emerald-200 dark:border-emerald-900 text-emerald-700 dark:text-emerald-400 font-bold text-sm\">\n                    🔐 تخزين محلي\n                </span>\n\n                <span class=\"px-4 py-2 rounded-full bg-white dark:bg-[#10251d] border border-emerald-200 dark:border-emerald-900 text-emerald-700 dark:text-emerald-400 font-bold text-sm\">\n                    💾 قاعدة بيانات Isar\n                </span>\n\n                <span class=\"px-4 py-2 rounded-full bg-white dark:bg-[#10251d] border border-emerald-200 dark:border-emerald-900 text-emerald-700 dark:text-emerald-400 font-bold text-sm\">\n                    🌐 لا يحتاج اتصال دائم\n                </span>\n\n            </div>\n\n        </div>\n    </div>\n\n\n    <!-- =========================\n         الذكاء الاصطناعي\n    ========================== -->\n    <div class=\"mb-10 rounded-[1.5rem] border border-violet-200 dark:border-violet-900/50 bg-gradient-to-br from-violet-50 to-blue-50 dark:from-violet-950/20 dark:to-blue-950/20 p-6 md:p-7\">\n\n        <h2 class=\"font-black text-xl mb-4 text-violet-800 dark:text-violet-400 flex items-center gap-2\">\n            <span>🤖</span>\n            التطبيق من برمجتي بمساعدة الذكاء الاصطناعي\n        </h2>\n\n        <p class=\"text-gray-700 dark:text-gray-300 leading-8\">\n            هذا التطبيق من برمجتي، وتم الاستفادة من\n            <strong class=\"text-violet-700 dark:text-violet-400\">\n                أدوات الذكاء الاصطناعي\n            </strong>\n            أثناء عملية التطوير والمساعدة البرمجية، مع تصميم وتنظيم فكرة التطبيق\n            وخصائصه بما يتناسب مع الاستخدام الفعلي للمعلم والإدارة.\n        </p>\n\n        <p class=\"mt-4 text-gray-700 dark:text-gray-300 leading-8\">\n            الفكرة بالنسبة إليّ ليست مجرد تطبيق آخر، وإنما محاولة لتحويل جزء من\n            العمل المدرسي اليومي إلى نظام أكثر\n            <strong class=\"text-blue-700 dark:text-blue-400\">تنظيمًا وسرعةً ووضوحًا</strong>.\n        </p>\n\n    </div>\n\n\n    <!-- =========================\n         النتيجة\n    ========================== -->\n    <div class=\"mb-10\">\n\n        <h2 class=\"font-black text-2xl mb-5 text-slate-900 dark:text-white flex items-center gap-2\">\n            <span>🎯</span>\n            الفكرة باختصار\n        </h2>\n\n        <div class=\"border-r-4 border-[#147d83] pr-5 py-2\">\n\n            <p class=\"text-gray-700 dark:text-gray-300 text-lg leading-9\">\n                <strong class=\"text-[#0f3d5e] dark:text-blue-300\">\n                    سجل الطالب\n                </strong>\n                يحاول اختصار الكثير من الأعمال اليومية في مكان واحد:\n                الطالب، الصف، الحضور، الدرجات، السلوك، الملاحظات والتقارير.\n            </p>\n\n            <p class=\"mt-4 text-gray-700 dark:text-gray-300 text-lg leading-9\">\n                بدل ما تكون المعلومات موزعة بين دفاتر وملفات متعددة،\n                تكون أمامك في\n                <strong class=\"text-emerald-700 dark:text-emerald-400\">\n                    ملف رقمي واحد ومنظم لكل طالب\n                </strong>.\n            </p>\n\n        </div>\n\n    </div>\n\n\n    <!-- =========================\n         الخاتمة / التفاعل\n    ========================== -->\n    <div class=\"relative overflow-hidden rounded-[1.7rem] bg-gradient-to-l from-[#102a43] via-[#123c5a] to-[#116466] p-7 md:p-9 text-white shadow-xl\">\n\n        <div class=\"absolute -right-12 -bottom-16 w-48 h-48 rounded-full bg-white/5\"></div>\n        <div class=\"absolute -left-10 -top-16 w-40 h-40 rounded-full bg-white/5\"></div>\n\n        <div class=\"relative z-10\">\n\n            <div class=\"inline-flex items-center gap-2 mb-4 px-4 py-2 rounded-full bg-white/10 border border-white/10 text-sm font-bold\">\n                💬 رأيكم يهمني\n            </div>\n\n            <h2 class=\"font-black text-2xl mb-4\">\n                شنو رأيكم بالفكرة؟\n            </h2>\n\n            <p class=\"text-white/85 text-lg leading-8 mb-6\">\n                التطبيق من برمجتي، وأكيد ما زال قابل للتطوير.\n                إذا عندك ملاحظة، فكرة، اقتراح ميزة، أو شفت شيء يحتاج تحسين،\n                اترك تعليق أو راسلني.\n            </p>\n\n            <div class=\"flex flex-wrap gap-3\">\n\n                <span class=\"px-4 py-2 rounded-xl bg-white/10 border border-white/15 font-bold\">\n                    💡 اقتراحاتكم\n                </span>\n\n                <span class=\"px-4 py-2 rounded-xl bg-white/10 border border-white/15 font-bold\">\n                    🛠️ ملاحظاتكم\n                </span>\n\n                <span class=\"px-4 py-2 rounded-xl bg-white/10 border border-white/15 font-bold\">\n                    📚 أفكار جديدة\n                </span>\n\n            </div>\n\n        </div>\n    </div>\n\n\n    <!-- =========================\n         توقيع بسيط\n    ========================== -->\n    <div class=\"text-center mt-8 pt-6 border-t border-slate-200 dark:border-slate-800\">\n\n        <p class=\"text-sm text-slate-500 dark:text-slate-500\">\n            🧑‍💻 تطوير وبرمجة شخصية •\n            <span class=\"font-bold text-[#0f766e] dark:text-teal-400\">\n                سجل الطالب\n            </span>\n        </p>\n\n    </div>\n\n</div>",
